// The compiler options every TypeScript package shares. Each one
// extends this and adds what is its own (lib, types, include).
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "erasableSyntaxOnly": true,
    "noEmit": true,
    // Effect's diagnostics, which the typecheck scripts run through
    // @effect/tsgo's build of the compiler. unstableApiUsage is off
    // because v3 builds on Effect's unstable modules by decision (sql,
    // rpc, process, cli, http) and would warn on every use. Effect is
    // pinned exactly, and EFFECT.md has those APIs read from the pinned
    // source, which is the guard the diagnostic stands for.
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": { "unstableApiUsage": "off" }
      }
    ]
  }
}
