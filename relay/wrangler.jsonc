// Cloudflare Worker config for the sm relay. Two environments share
// this file, the wrangler way: the top level IS production
// (`shigomori-relay`) and `env.dev` overrides the name and the D1
// binding to make `shigomori-relay-dev`. Bindings are not inherited by
// named environments, so `env.dev` repeats every binding block.
//
// `pnpm run deploy` targets dev (`--env dev`) and `pnpm run
// deploy:prod` the top level, so a bare deploy never lands on
// production by accident. Secrets are per environment too: `wrangler
// secret put NAME --env dev` for dev, no flag for production.
//
// Secrets never live here. CLERK_SECRET_KEY is a wrangler secret, read
// by src/index.ts to verify Clerk session tokens at enrollment. Each
// environment holds the key of ITS Clerk instance (development for
// dev, production for prod).
//
// Plain vars the owner may set (via `vars` here or the dashboard):
// - TICKET_TTL_MS: override of the 60s connection ticket TTL. Mostly a
//   test seam, production should leave it unset.
//
// Tunnel provisioning (v2 step 10, slice B), all optional: with any of
// them unset, POST /tunnel answers the typed "not configured" and the
// rest of the Worker works as before. All four are set as wrangler
// secrets (dashboard-set plain vars do not survive a deploy, and the
// real values do not belong in this file). Placeholders only:
// - CLOUDFLARE_API_TOKEN: an API token with Cloudflare Tunnel edit on
//   the account and DNS edit on the tunnel zone below, nothing else.
// - CF_ACCOUNT_ID: the Cloudflare account id tunnels are created
//   under, e.g. "0000000000000000000000000000000c".
// - TUNNEL_ZONE_ID: the DNS zone id the per-device CNAMEs are written
//   into, e.g. "0000000000000000000000000000000z". A zone that holds
//   nothing but tunnels, so the token cannot touch other records.
// - TUNNEL_DOMAIN: the zone apex, e.g. "example.link". Each device
//   gets `sm-<hash>.<TUNNEL_DOMAIN>`; the apex keeps the hostnames one
//   level deep, which is all Universal SSL covers. Both environments
//   can share one zone: device names hash the Clerk user id, which
//   differs per Clerk instance.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shigomori-relay",
  "main": "src/index.ts",
  // Recent, and within the range supported by the workerd that
  // @cloudflare/vitest-pool-workers runs the test suite on.
  "compatibility_date": "2026-08-01",
  "durable_objects": {
    "bindings": [
      {
        "name": "ACCOUNT_RELAY",
        "class_name": "AccountRelay",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      // SQLite-backed storage is required for new DO classes and is
      // what the hibernation-era APIs assume.
      "new_sqlite_classes": ["AccountRelay"],
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shigomori-relay",
      // The deployed production database's id (printed by `wrangler
      // d1 create`; not a secret). Local dev and the vitest suite
      // ignore it.
      "database_id": "8f575d6b-567f-4df5-ab63-76af4a72ec21",
      "migrations_dir": "migrations",
    },
  ],
  "observability": {
    "enabled": true,
  },
  "env": {
    "dev": {
      "name": "shigomori-relay-dev",
      "durable_objects": {
        "bindings": [
          {
            "name": "ACCOUNT_RELAY",
            "class_name": "AccountRelay",
          },
        ],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "shigomori-relay-dev",
          "database_id": "a5e7d3b9-0868-4e1a-af76-37d59e708878",
          "migrations_dir": "migrations",
        },
      ],
      "observability": {
        "enabled": true,
      },
    },
  },
}
