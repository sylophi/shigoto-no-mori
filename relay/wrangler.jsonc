// Cloudflare Worker config for the sm relay. Secrets never live here:
// CLERK_SECRET_KEY is a wrangler secret (`wrangler secret put
// CLERK_SECRET_KEY`), read by src/index.ts to verify Clerk OAuth
// application access tokens at enrollment.
//
// Plain vars the owner may set (via `vars` here or the dashboard):
// - ALLOWED_WEB_ORIGIN: exact origin of the future step-8 web client.
//   Unset means only Origin-less clients (the desktop app) may call
//   the API. See the origin gate in src/worker.ts.
// - TICKET_TTL_MS: override of the 60s connection ticket TTL. Mostly a
//   test seam, production should leave it unset.
//
// Tunnel provisioning (v2 step 10, slice B), all optional: with any of
// them unset, POST /tunnel answers the typed "not configured" and the
// rest of the Worker works as before. Placeholders only, never real
// values:
// - CLOUDFLARE_API_TOKEN: a wrangler secret (`wrangler secret put
//   CLOUDFLARE_API_TOKEN`), an API token with Cloudflare Tunnel edit
//   and DNS edit permissions on the account and zone below.
// - CF_ACCOUNT_ID: the Cloudflare account id tunnels are created
//   under, e.g. "0000000000000000000000000000000c".
// - TUNNEL_ZONE_ID: the DNS zone id the per-device CNAMEs are written
//   into, e.g. "0000000000000000000000000000000z".
// - TUNNEL_DOMAIN: the tunnel parent domain inside that zone, e.g.
//   "sm.example.com". Each device gets `sm-<hash>.<TUNNEL_DOMAIN>`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sm-relay",
  "main": "src/index.ts",
  // Recent, and within the range supported by the workerd that
  // @cloudflare/vitest-pool-workers runs the test suite on.
  "compatibility_date": "2026-08-01",
  "durable_objects": {
    "bindings": [
      {
        "name": "ACCOUNT_RELAY",
        "class_name": "AccountRelay",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      // SQLite-backed storage is required for new DO classes and is
      // what the hibernation-era APIs assume.
      "new_sqlite_classes": ["AccountRelay"],
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sm-relay",
      // PLACEHOLDER: replace with the id printed by
      // `wrangler d1 create sm-relay` before deploying. Local dev and
      // the vitest suite ignore it.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
