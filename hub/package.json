{
  "name": "shigomori-hub",
  "private": true,
  "version": "0.0.0",
  "description": "Cloudflare Worker hub for Shigoto no Mori (v2 step 4): forwards opaque frames between an account's devices, no sm logic.",
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "dev": "wrangler dev --env dev",
    "deploy": "wrangler deploy --env dev",
    "deploy:prod": "wrangler deploy --env \"\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run"
  },
  "dependencies": {
    "@clerk/backend": "^3.16.0",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.0",
    "@cloudflare/workers-types": "^5.20260801.0",
    "typescript": "~7.0.2",
    "vitest": "^4.1.9",
    "wrangler": "^4.120.0"
  }
}
