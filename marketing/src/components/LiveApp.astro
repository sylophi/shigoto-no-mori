---
// The real app in one of the page's frames, where a screenshot would
// be: the app's UI lab, its fixture world posed by URL (the app's
// lab/README.md), built into /demo/ and running in an iframe. A whole
// window can be clicked around in. A region of one is only shown.
// scripts/live.ts scales the window to the frame and runs the pose.
import type { Action } from "../scripts/live";

interface Props {
  // The lab's pose parameters, as a query string without the "?".
  pose: string;
  // What the frame shows, for screen readers. Empty for a decorative
  // frame, which is then hidden from them.
  title: string;
  frame: "window" | "phone" | "floating" | "card-shot" | "framed";
  class?: string;
  // The window's size in CSS pixels, before it is scaled to the frame.
  size?: [number, number];
  // The part of the window to show: x, y, width and height. With an
  // anchor, x and y count from that element's corner instead of the
  // window's, so the region follows it when the layout moves.
  region?: [number, number, number, number];
  anchor?: string;
  // Clicks and waits that pose it further, like opening a menu.
  actions?: Action[];
  // On the first screen: loaded right away, not lazily.
  eager?: boolean;
}
const {
  pose,
  title,
  frame,
  class: className,
  size = [1280, 800],
  region,
  anchor,
  actions = [],
  eager,
} = Astro.props;
const [width, height] = size;
const rect = region ?? [0, 0, width, height];
const interactive = region === undefined && title !== "";
---

<figure
  class:list={[frame, "live", { "live-interactive": interactive }, className]}
  aria-hidden={title === "" ? "true" : undefined}
  data-live
  data-region={JSON.stringify({ rect, anchor })}
  data-actions={JSON.stringify(actions)}
>
  <div class="live-view" style={`--live-w: ${rect[2]}; --live-h: ${rect[3]}`}>
    <iframe
      src={`/demo/?${pose}`}
      title={title || undefined}
      width={width}
      height={height}
      loading={eager ? "eager" : "lazy"}
      tabindex={interactive ? undefined : -1}></iframe>
  </div>
  <slot />
</figure>
