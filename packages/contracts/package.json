{
  "name": "@shigomori/contracts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./schemas": "./src/schemas/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "$(effect-tsgo get-exe-path) && $(effect-tsgo get-exe-path) -p test",
    "test": "vitest run",
    "wire-fixtures": "UPDATE_WIRE_FIXTURES=1 vitest run test/wire.test.ts && pnpm -w exec oxfmt packages/contracts/fixtures/wire"
  },
  "dependencies": {
    "effect": "catalog:",
    "semver": "7.8.5"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@types/node": "catalog:",
    "@types/semver": "7.7.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
