{
  "MigrationStepStateSchema": {
    "accepts": ["waiting", "running", "done", "stuck"],
    "rejects": ["skipped", null, 1]
  },
  "StuckWorktreeSchema": {
    "accepts": [
      {
        "name": "gentle-gecko",
        "reason": "cannot move a locked working tree"
      }
    ],
    "rejects": [
      {
        "name": "gentle-gecko"
      },
      {
        "name": 1,
        "reason": "x"
      }
    ]
  },
  "WorktreeMoveStepSchema": {
    "accepts": [
      {
        "state": "running",
        "moved": 3,
        "total": 6,
        "current": "happy-hummingbird",
        "stuck": []
      },
      {
        "state": "stuck",
        "moved": 5,
        "total": 6,
        "current": null,
        "stuck": [
          {
            "name": "gentle-gecko",
            "reason": "cannot move a locked working tree"
          }
        ]
      }
    ],
    "normalizes": [
      {
        "input": {
          "state": "running",
          "moved": 3,
          "total": 6,
          "current": "happy-hummingbird",
          "stuck": [],
          "extra": 1
        },
        "output": {
          "state": "running",
          "moved": 3,
          "total": 6,
          "current": "happy-hummingbird",
          "stuck": []
        }
      }
    ],
    "rejects": [
      {
        "state": "running",
        "moved": 3,
        "total": 6,
        "current": 1,
        "stuck": []
      },
      {
        "state": "running",
        "moved": 3,
        "total": 6,
        "current": "happy-hummingbird",
        "stuck": null
      },
      {
        "state": "running"
      }
    ]
  },
  "StoreMigrationSchema": {
    "accepts": [
      {
        "planned": false,
        "import": null,
        "worktrees": null
      },
      {
        "planned": true,
        "import": null,
        "worktrees": null
      },
      {
        "planned": true,
        "import": {
          "state": "done"
        },
        "worktrees": {
          "state": "running",
          "moved": 3,
          "total": 6,
          "current": "happy-hummingbird",
          "stuck": []
        }
      }
    ],
    "rejects": [
      {
        "planned": true
      },
      {
        "planned": true,
        "import": {
          "state": "later"
        },
        "worktrees": null
      }
    ]
  },
  "MigrationSchema": {
    "accepts": [
      {
        "planned": true,
        "import": null,
        "worktrees": null,
        "signIn": null
      },
      {
        "planned": true,
        "import": {
          "state": "done"
        },
        "worktrees": {
          "state": "stuck",
          "moved": 5,
          "total": 6,
          "current": null,
          "stuck": [
            {
              "name": "gentle-gecko",
              "reason": "cannot move a locked working tree"
            }
          ]
        },
        "signIn": {
          "state": "waiting",
          "lapsed": true
        }
      }
    ],
    "rejects": [
      {
        "planned": true,
        "import": {
          "state": "done"
        },
        "worktrees": {
          "state": "running",
          "moved": 3,
          "total": 6,
          "current": "happy-hummingbird",
          "stuck": []
        }
      },
      {
        "planned": true,
        "import": null,
        "worktrees": null,
        "signIn": {
          "state": "done"
        }
      }
    ]
  }
}
