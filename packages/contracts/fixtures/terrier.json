{
  "TerrierReadinessSchema": {
    "accepts": [
      {
        "installed": true,
        "readable": true
      },
      {
        "installed": true,
        "readable": false
      },
      {
        "installed": false,
        "readable": false
      }
    ],
    "normalizes": [
      {
        "input": {
          "installed": true,
          "readable": true,
          "path": "/opt/homebrew/bin/terrier"
        },
        "output": {
          "installed": true,
          "readable": true
        }
      }
    ],
    "rejects": [
      {
        "installed": true
      },
      {
        "installed": "yes",
        "readable": false
      },
      {
        "installed": true,
        "compatible": true,
        "version": "0.4.2"
      }
    ]
  }
}
