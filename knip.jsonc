{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      // test/testProcesses.setup.mts runs under each workspace's own
      // vitest, which its vitest config names.
      "ignoreDependencies": ["vitest"],
    },
    "app": {
      "entry": [
        // forge.config.ts names main's and the host's entries to Vite as
        // strings.
        "forge.config.ts",
        "main/index.ts",
        "host/process/host.ts",
        "vite.*.config.ts",
        // The fake host (lab/fake-host/README.md): its pages load their
        // scripts by root-relative path (scenes.tsx is the scene
        // viewer's), and clerkStub.tsx stands in for Clerk through a
        // Vite alias in vite.base.ts.
        "lab/fake-host/{web-main,villager-icons,clerkStub,scenes}.tsx",
        // The proofs, which vitest runs.
        "test/*.mts",
        // Run through package.json scripts or by hand (their headers say how).
        "scripts/*.{mts,cts}",
        // A lab check run by hand against a packaged build.
        "lab/relaunch.mts",
      ],
    },
    "hub": {
      "ignoreDependencies": [
        // cloudflare:workers is workerd's built-in module.
        "cloudflare",
      ],
    },
    "marketing": {},
    // Its exports map makes every module an entry, and an entry's
    // exports count as used unless this says otherwise.
    "packages/contracts": {
      "includeEntryExports": true,
    },
    "packages/cli": {
      // The entrypoint Bun compiles.
      "entry": ["src/main.ts"],
    },
    // Its exports map makes every module an entry, like the contracts'.
    "packages/ui": {
      "includeEntryExports": true,
    },
    // Its exports map makes every module an entry, like the contracts'.
    "packages/engine": {
      "includeEntryExports": true,
      // Run by path from the store's crash test, in a process of its
      // own.
      "entry": ["test/fixtures/*.ts"],
    },
  },
  "ignoreBinaries": [
    // System tools and the owner's own port-pool, not npm packages.
    "go",
    "plutil",
    "osascript",
    "pgrep",
    "ditto",
    "port-pool",
    // app's, run by release.yml from app/ (knip reads it from the root).
    "electron-forge",
  ],
}
