{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "app": {
      "entry": [
        // forge.config.ts names main's entry to Vite as a string.
        "forge.config.ts",
        "main/index.ts",
        "vite.*.config.ts",
        // The fake host (lab/fake-host/README.md): its pages load their
        // scripts by root-relative path, and clerkStub.tsx stands in for
        // Clerk through a Vite alias in vite.base.ts.
        "lab/fake-host/{web-main,villager-icons,clerkStub}.tsx",
        // The proofs, which vitest runs, and the bench, a script run by hand.
        "test/*.mts",
        "test/bench/*.mts",
        // Run through package.json scripts or by hand (their headers say how).
        "scripts/*.{mts,cts}",
      ],
      "ignoreDependencies": [
        // Loaded from an inline script in index.html, in dev only.
        "react-grab",
      ],
    },
    "hub": {
      "ignoreDependencies": [
        // cloudflare:test and cloudflare:workers are workerd's built-in
        // modules, provided by @cloudflare/vitest-pool-workers.
        "cloudflare",
      ],
    },
    "marketing": {},
    // Its exports map makes every module an entry, and an entry's
    // exports count as used unless this says otherwise.
    "packages/contracts": {
      "includeEntryExports": true,
    },
    "packages/engine": {
      // Run by path from the store's test, in a process of its own.
      "entry": ["test/fixtures/*.ts"],
    },
  },
  "ignoreBinaries": [
    // System tools and the owner's own port-pool, not npm packages.
    "go",
    "plutil",
    "osascript",
    "pgrep",
    "port-pool",
    // app's, run by release.yml from app/ (knip reads it from the root).
    "electron-forge",
  ],
}
