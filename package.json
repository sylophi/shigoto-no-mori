{
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "postinstall": "pnpm -r run postinstall",
    "start": "pnpm -F ./app start",
    "dev": "pnpm -F ./app dev",
    "device": "pnpm -F ./app device",
    "test": "pnpm -F ./app test",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "web:dev": "pnpm -F ./app web:dev",
    "web:build": "pnpm -F ./app web:build",
    "fake-host": "pnpm -F ./app fake-host",
    "fake-host:web": "pnpm -F ./app fake-host:web",
    "package": "pnpm -F ./app package",
    "make": "pnpm -F ./app make",
    "check": "pnpm run check:typecheck && pnpm run check:lint && pnpm run check:lint-rules && pnpm run check:format && pnpm run check:knip && pnpm run check:licenses && pnpm run check:proofs && pnpm run check:hub && pnpm run check:go",
    "check:typecheck": "pnpm run typecheck",
    "check:lint": "pnpm run lint",
    "check:lint-rules": "pnpm -F @shigomori/lint test",
    "check:format": "pnpm run format:check",
    "check:knip": "knip",
    "check:licenses": "pnpm -C app licenses:check",
    "check:proofs": "pnpm -C app test",
    "check:hub": "pnpm -C hub run check",
    "check:go": "go test -C cli ./... && CGO_CFLAGS=-Wno-deprecated-declarations go test -C file-sync ./..."
  },
  "devDependencies": {
    "knip": "6.39.0",
    "lefthook": "^2.1.10",
    "oxfmt": "0.58.0",
    "oxlint": "catalog:"
  }
}
