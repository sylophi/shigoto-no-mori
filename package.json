{
  "name": "shigoto-no-mori",
  "productName": "Shigoto no Mori",
  "version": "0.2.0",
  "description": "Lightweight desktop app for managing git worktrees in parallel.",
  "main": ".vite/build/main.js",
  "private": true,
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "start": "port-pool ensure . && electron-forge start",
    "dev": "pnpm run start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "extract-icon": "scripts/extract-app-icon.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@pierre/diffs": "^1.1.21",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-router": "1.169.2",
    "anser": "^2.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron-squirrel-startup": "^1.0.1",
    "lucide-react": "^0.577.0",
    "material-icon-theme": "^5.34.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-dmg": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@electron-forge/shared-types": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.2.1",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^22.13.10",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "electron": "42.0.0",
    "lefthook": "^2.1.4",
    "oxfmt": "0.48.0",
    "oxlint": "1.63.0",
    "react-grab": "^0.1.33",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "vite": "^8.0.0"
