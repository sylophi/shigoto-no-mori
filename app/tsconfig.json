{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": [
      "node",
      "vite/client",
      "@electron-forge/plugin-vite/forge-vite-env"
    ],
    "useDefineForClassFields": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "sourceMap": true,
    "paths": {
      "@/*": ["./renderer/*"],
      "@shared/*": ["./shared/*"],
      "@host/*": ["./host/*"]
    }
  },
  "include": [
    "main/**/*",
    "host/**/*",
    "renderer/**/*",
    "shared/**/*",
    "web/**/*",
    "lab/fake-host/**/*",
    "lab/scenes/**/*",
    "lab/reliability/**/*",
    "lab/walks/**/*",
    "scripts/**/*.mts",
    "scripts/**/*.cts",
    "test/**/*.mts",
    "forge.config.ts",
    "forge.env.d.ts",
    "vite.*.config.ts",
    "vitest.config.ts",
    "vite.reactCompiler.ts",
    "vite.dedupe.ts"
  ],
  // Outputs a run writes inside the tree, gitignored but not hidden
  // from the compiler, which a copy of the repo in one would swamp.
  "exclude": ["lab/reliability/report", "lab/fake-host/villager-data"]
}
