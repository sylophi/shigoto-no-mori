{
  "name": "shigoto-no-mori",
  "productName": "Shigoto no Mori",
  "version": "0.0.0",
  "description": "Lightweight desktop app for managing git worktrees in parallel.",
  "author": "sylophi",
  "license": "MIT",
  "main": ".vite/build/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/sylophi/shigoto-no-mori.git"
  },
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node scripts/dev-cli.mts && node scripts/fetch-cloudflared.mts --best-effort && node scripts/ensure-ports.mts && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/dev-electron.mts",
    "dev": "pnpm run start",
    "device": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/dev-device.mts",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "typecheck": "$(effect-tsgo get-exe-path)",
    "test": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON test/run.mts",
    "web:dev": "node scripts/ensure-ports.mts && vite --config vite.web.config.ts",
    "web:build": "node scripts/copy-material-icons.mts && vite build --config vite.web.config.ts",
    "fake-host": "node scripts/ensure-ports.mts && vite --config lab/fake-host/vite.config.ts",
    "fake-host:web": "node scripts/ensure-ports.mts && vite --config lab/fake-host/vite.web.config.ts",
    "licenses": "node scripts/generate-third-party-licenses.mts",
    "villagers:fetch": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./test/lib/register-ts-alias.mts scripts/fetch-villager-data.mts",
    "licenses:check": "node scripts/generate-third-party-licenses.mts --check",
    "extract-icon": "scripts/extract-app-icon.sh",
    "dmg:background": "electron scripts/build-dmg-background.cts",
    "cli:build": "node scripts/build-cli.mts",
    "file-sync:build": "node scripts/build-file-sync.mts",
    "macfs:build": "node scripts/build-macfs.mts",
    "cli:install": "node scripts/install-cli.mts",
    "postinstall": "node scripts/copy-material-icons.mts && node scripts/fix-node-pty-helper.mts"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@clerk/electron": "0.0.35",
    "@clerk/react": "6.14.5",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@effect/platform-node": "catalog:",
    "@effect/sql-sqlite-node": "catalog:",
    "@pierre/diffs": "^1.4.3",
    "@shigomori/contracts": "workspace:*",
    "@shigomori/engine": "workspace:*",
    "@shigomori/ui": "workspace:*",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "1.170.17",
    "@tanstack/react-virtual": "^3.14.5",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "cmdk": "^1.1.1",
    "dompurify": "catalog:",
    "effect": "catalog:",
    "electron-log": "5.4.4",
    "lucide-react": "catalog:",
    "marked": "catalog:",
    "material-icon-theme": "catalog:",
    "node-pty": "1.1.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-error-boundary": "^6.1.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "catalog:",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@effect/tsgo": "catalog:",
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/publisher-github": "7.11.2",
    "@electron-forge/shared-types": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv": "^17.4.2",
    "electron": "43.1.0",
    "license-checker": "^25.0.1",
    "react-grab": "^0.1.48",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
