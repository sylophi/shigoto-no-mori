.DS_Store
*.log
*.tsbuildinfo
coverage/

node_modules/

# dotenv environment variables file
.env
.env.*
!.env.example

# Local, non-secret account service config (ACCOUNT_ENV_KEYS) read
# as a dev convenience by main/electron/account.ts and loaded by Vite
# for the web build. Never committed.
.env*.local

# Vite
.vite/
dist/

# Per-worktree dev app bundle (scripts/dev-electron.mts)
.electron-dev/

# Web client build output (vite.web.config.ts)
dist-web/

# Electron-Forge
out/

# The villager data the fake host serves, downloaded from Nookipedia by
# `pnpm villagers:fetch` (scripts/fetch-villager-data.mts). Never
# committed: the app downloads it at runtime.
app/lab/fake-host/villager-data/

# Third-party notices, generated at packaging (forge prePackage,
# scripts/package-linux.mts)
app/resources/licenses/

# App icon intermediates (icon.icns and icon.png are the committed sources)
app/assets/icon.iconset/

# sm CLI compiled binary (scripts/build-cli.mts)
dist-cli/

# bundled cloudflared, fetched by scripts/fetch-cloudflared.mts
dist-cloudflared/

# file-sync engine compiled binary (scripts/build-go.mts)
dist-file-sync/
file-sync/file-sync
file-sync/filesync
file-sync/filesync.exe

# headless host bundle (scripts/build-headless.mts)
dist-headless/

# the node a Linux package ships, fetched by scripts/fetch-node.mts
dist-node/

# filesystem helper compiled binary (scripts/build-go.mts)
dist-nativefs/
nativefs/nativefs
nativefs/nativefs.exe

# The scene comparison's report (app/lab/scene-compare)
app/lab/scene-compare/report/
# The reliability harness's report (app/lab/reliability)
app/lab/reliability/report/
# The guide's how-tos' report (app/lab/guide-eval)
app/lab/guide-eval/report/
