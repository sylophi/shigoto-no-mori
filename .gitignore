.DS_Store
*.log
*.tsbuildinfo

node_modules/

# dotenv environment variables file
.env
.env.*
!.env.example

# Local, non-secret account service config (ACCOUNT_ENV_KEYS) read
# as a dev convenience by main/ipc/modules/account.ts and loaded by Vite
# for the web build. Never committed.
.env*.local

# Vite
.vite/
dist/

# Per-worktree dev app bundle (scripts/dev-electron.mts)
.electron-dev/

# Web client build output (vite.web.config.ts)
dist-web/

# Synced from node_modules/material-icon-theme by
# scripts/copy-material-icons.mjs (postinstall). Vite serves public/ as a
# static asset root, which avoids the 1238 per-icon ESM wrappers an eager
# import.meta.glob would otherwise generate in dev.
public/material-icons/

# Electron-Forge
out/

# App icon intermediates (icon.icns and icon.png are the committed sources)
assets/icon.iconset/

# sm CLI compiled binary (scripts/build-cli.mjs)
dist-cli/

# bundled cloudflared, fetched by scripts/fetch-cloudflared.mjs
dist-cloudflared/

# file-sync engine compiled binary (scripts/build-file-sync.mjs)
dist-file-sync/
file-sync/file-sync
file-sync/filesync

# go build artifacts in the module dir (compiled output belongs in dist-cli/)
cli/sm
cli/smd
cli/cli
