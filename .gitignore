coverage
*.lcov

# nyc test coverage
.nyc_output

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# TypeScript v1 declaration files
typings/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env
.env.test

# parcel-bundler cache (https://parceljs.org/)
.cache

# next.js build output
.next

# nuxt.js build output
.nuxt

# vuepress build output
.vuepress/dist

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# Webpack
.webpack/

# Vite
.vite/
dist/

# Synced from node_modules/material-icon-theme by
# scripts/copy-material-icons.mjs (postinstall). Vite serves public/ as a
# static asset root, which avoids the 1238 per-icon ESM wrappers an eager
# import.meta.glob would otherwise generate in dev.
public/material-icons/

# Electron-Forge
out/

# App icon intermediates (icon.icns and icon.png are the committed sources)
assets/icon.iconset/

# sgm CLI compiled binary
dist-cli/

# go build artifacts in the module dir (compiled output belongs in dist-cli/)
cli/sm
cli/smd
cli/sgm
cli/cli
